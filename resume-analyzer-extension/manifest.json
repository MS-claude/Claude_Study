{
  "manifest_version": 3,
  "name": "Resume Analyzer",
  "version": "1.2.0",
  "description": "AI-powered resume screening assistant with learning capabilities",
  "key": "",
  "permissions": [
    "activeTab",
    "identity",
    "scripting",
    "storage",
    "tabs",
    "sidePanel",
    "windows"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "oauth2": {
    "client_id": "726524967668-19pkd9oir0cp3p3p750pnnisf01nargp.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/spreadsheets"
    ]
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Resume Analyzer"
  },
  "side_panel": {
    "default_path": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
